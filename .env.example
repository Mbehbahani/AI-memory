# ---- AI Memory V0.1 — environment template. Copy to .env; never commit .env. ----
# Generate strong passwords with: scripts/init-env.ps1

COMPOSE_PROJECT_NAME=ai-memory
DEVICE_ID=local-development-machine

# PostgreSQL (system of record)
POSTGRES_DB=aimemory
POSTGRES_USER=aimemory
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://aimemory:change-me@postgres:5432/aimemory

# Neo4j (rebuildable projection)
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_READONLY_USER=memory_reader
NEO4J_READONLY_PASSWORD=change-me
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
# Frugal defaults (idle stack ~3-4 GB ESTIMATED). Raise only if queries show page-cache pressure.
NEO4J_HEAP_MAX=512M
NEO4J_PAGECACHE=256M
NEO4J_IMAGE_TAG=5.26-community

# Ollama (extraction LLM)
OLLAMA_URL=http://ollama:11434
OLLAMA_IMAGE_TAG=0.34.0
LLM_PROVIDER=bedrock
LLM_MODEL=qwen3:4b
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=1024
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
# Model is unloaded after this idle time (container drops to ~0.1 GB). Ingestion runs raise it to 30m for their duration.
OLLAMA_KEEP_ALIVE=5m
OLLAMA_CPUS=3.0

# Embedding service
EMBED_URL=http://embedding-service:8010
EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIMENSIONS=384
EMBED_BATCH_SIZE=32
EMBED_MAX_SEQ=256
TORCH_NUM_THREADS=2
EMBED_TIMEOUT_SECONDS=120

# Source roots (host paths; mounted read-only). Add more roots in config/source-roots.yaml.
HOST_VAULT_ROOT=D:/My-Vault
HOST_PILOT_ROOT=D:/AWS2/SupaBaseProject/DE

# Ingestion
INGEST_LLM_CONCURRENCY=1
INGEST_EMBED_CONCURRENCY=2
INGEST_MAX_TEXT_BYTES=2097152
INGEST_WORKER_POLL_SECONDS=5.0
# Advanced/internal path overrides (MEMORY_CONFIG_DIR, MEMORY_SCHEMA_DIR, MEMORY_SOURCE_ROOTS_FILE,
# MEMORY_IGNORE_FILE, INGEST_STATE_DIR) default to container-conventional paths (see
# packages/aimemory/common/config.py) and are already set correctly per-service in docker-compose.yml
# volume mounts; leave unset here unless you are overriding a container path deliberately.

# Memory Gateway / MCP
MEMORY_API_HOST_PORT=8000
MCP_HOST_PORT=8020
MEMORY_API_URL=http://memory-api:8000
GATEWAY_WRITE_ENABLED=false
GATEWAY_OPS_ENABLED=true
MCP_WRITE_ENABLED=false
MCP_TRANSPORT=streamable-http
MCP_RATE_LIMIT_PER_MINUTE=10
MCP_MAX_TEXT_CHARS=8000

# Visualization
NEODASH_HOST_PORT=5005
NEODASH_IMAGE_TAG=2.4.11

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Bedrock extraction provider (ADR-0012). Only used when LLM_PROVIDER=bedrock. ---
# Selecting bedrock sends source text to AWS. Assumption B16 ("no cloud calls at runtime") and
# AC-8 ("nothing leaves the machine") do NOT hold in that mode. Credentials are never set here:
# boto3's standard chain resolves them (read-only mounted ~/.aws, or AWS_* environment).
# Use the inference-profile id, not the bare model id (the bare id rejects on-demand invoke).
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=4096
# AWS_PROFILE=mohabehb
